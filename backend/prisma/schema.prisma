// Schéma Prisma — fondation (Auth + Société + Audit).
// Les modules métier (Chantiers, Devis, Factures, Stock, RH, Finances...)
// seront ajoutés au fil des étapes suivantes, chacun avec sa propre
// migration versionnée.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["tce_maroc"]
}

enum Role {
  ADMIN
  DIRECTEUR
  CONDUCTEUR_TRAVAUX
  COMPTABLE
  MAGASINIER
  COMMERCIAL

  @@schema("tce_maroc")
}

// Un ERP interne à l'entreprise : pas d'inscription publique, les comptes
// sont créés par un administrateur (module Administration, à venir).
model Utilisateur {
  id         String   @id @default(uuid())
  email      String   @unique
  motDePasse String // haché (bcrypt), jamais en clair
  nom        String
  prenom     String
  role       Role
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Charte de couleurs personnelle (hex #RRGGBB) — préférence d'affichage
  // propre à ce compte, indépendante des autres utilisateurs. null = couleurs
  // par défaut de l'application.
  couleurPrimaire String?
  couleurAccent   String?

  refreshTokens    RefreshToken[]
  journalEntries   JournalAudit[]
  chantiersDiriges Chantier[]
  documents        Document[]

  @@schema("tce_maroc")
}

// Jetons de rafraîchissement JWT : révocables individuellement (déconnexion,
// changement de mot de passe) sans invalider tous les appareils.
model RefreshToken {
  id            String      @id @default(uuid())
  token         String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([utilisateurId])
  @@schema("tce_maroc")
}

// Paramètres légaux et de facturation de l'entreprise. Ligne unique en
// pratique (l'app gère une seule société), mais modélisée comme une table
// pour rester extensible (ex. multi-société plus tard).
model Societe {
  id             String  @id @default(uuid())
  nom            String
  formeJuridique String?
  adresse        String?
  ville          String?
  telephone      String?
  email          String?
  logo           String? // data URI ou URL de stockage
  cachet         String? // data URI du cachet/tampon d'entreprise, affiché à la demande sur les documents imprimés

  // Identifiants légaux marocains
  ice               String?
  rc                String?
  identifiantFiscal String?
  patente           String?
  cnss              String?
  rib               String?

  // Paramètres fiscaux / financiers par défaut (ajustables par document)
  tauxTvaDefaut       Decimal @default(20) @db.Decimal(5, 2)
  tauxRetenueGarantie Decimal @default(10) @db.Decimal(5, 2)
  tauxRetenueSource   Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numerotations Numerotation[]

  @@schema("tce_maroc")
}

// Compteur de numérotation par type de document (devis, facture, bon de
// commande, situation...), avec préfixe et remise à zéro annuelle
// configurables — répond à l'exigence de numérotation continue et
// paramétrable des pièces.
model Numerotation {
  id            String  @id @default(uuid())
  societeId     String
  societe       Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  typeDocument  String // ex. 'DEVIS', 'FACTURE', 'BON_COMMANDE', 'SITUATION'
  prefixe       String // ex. 'DEV', 'FACT'
  anneeCourante Int
  dernierNumero Int     @default(0)
  resetAnnuel   Boolean @default(true)

  @@unique([societeId, typeDocument])
  @@schema("tce_maroc")
}

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  MAITRE_OUVRAGE_PUBLIC

  @@schema("tce_maroc")
}

// CRM léger : particuliers, entreprises, maîtres d'ouvrage publics.
// L'historique (chantiers/devis/factures liés) et l'encours se calculeront
// via les relations ajoutées par les modules Chantiers et Devis/Facturation
// — pas de duplication de données ici.
model Client {
  id                String     @id @default(uuid())
  type              TypeClient @default(ENTREPRISE)
  nom               String // raison sociale, ou nom complet pour un particulier
  contactNom        String? // personne à contacter (entreprise / MO public)
  ice               String?
  rc                String?
  identifiantFiscal String?
  adresse           String?
  ville             String?
  telephone         String?
  email             String?
  notes             String?
  actif             Boolean    @default(true) // suppression douce : préserve l'historique une fois lié à des chantiers/devis
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  chantiers     Chantier[]
  devis         Devis[]
  commandes     Commande[]
  factures      Facture[]
  bonsLivraison BonLivraison[]

  @@index([nom])
  @@schema("tce_maroc")
}

// Fournisseurs de matériaux/services (achats), distincts des sous-traitants
// (main-d'œuvre) — modèles séparés car leurs usages et champs métier
// divergent (catégorie d'achat vs corps d'état).
model Fournisseur {
  id                String   @id @default(uuid())
  nom               String
  categorie         String? // ex. 'Matériaux', 'Location matériel', 'Services'
  contactNom        String?
  ice               String?
  rc                String?
  identifiantFiscal String?
  adresse           String?
  ville             String?
  telephone         String?
  email             String?
  evaluation        Int? // note 1 à 5
  notes             String?
  actif             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  depenses             DepenseChantier[]
  commandesFournisseur CommandeFournisseur[]
  mouvementsTresorerie MouvementTresorerie[]

  @@index([nom])
  @@schema("tce_maroc")
}

model SousTraitant {
  id                String   @id @default(uuid())
  nom               String
  corpsDetat        String? // ex. 'Électricité', 'Plomberie', 'Étanchéité'...
  contactNom        String?
  ice               String?
  rc                String?
  identifiantFiscal String?
  adresse           String?
  ville             String?
  telephone         String?
  email             String?
  evaluation        Int? // note 1 à 5
  notes             String?
  actif             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  depenses              DepenseChantier[]
  mouvementsTresorerie  MouvementTresorerie[]
  contratsSousTraitance ContratSousTraitant[]

  @@index([nom])
  @@schema("tce_maroc")
}

enum StatutChantier {
  EN_PREPARATION
  EN_COURS
  EN_RETARD
  SUSPENDU
  TERMINE
  ANNULE

  @@schema("tce_maroc")
}

// Fiche chantier : client, budget prévisionnel, dates, avancement, statut.
// Le budget "réel" et l'écart se calculent à la volée à partir des
// DepenseChantier liées — pas de duplication d'un total qui se
// désynchroniserait des dépenses réelles.
model Chantier {
  id                 String         @id @default(uuid())
  nom                String
  clientId           String?
  client             Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  adresse            String?
  ville              String?
  budgetPrevisionnel Decimal?       @db.Decimal(14, 2)
  dateDebut          DateTime?
  dateFinPrevue      DateTime?
  dateFinReelle      DateTime?
  avancement         Int            @default(0) // 0-100, mis à jour manuellement par le conducteur de travaux
  statut             StatutChantier @default(EN_PREPARATION)
  conducteurId       String?
  conducteur         Utilisateur?   @relation(fields: [conducteurId], references: [id], onDelete: SetNull)
  description        String?
  actif              Boolean        @default(true) // suppression douce
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  taches                TacheChantier[]
  depenses              DepenseChantier[]
  devis                 Devis[]
  commandes             Commande[]
  factures              Facture[]
  commandesFournisseur  CommandeFournisseur[]
  bonsLivraison         BonLivraison[]
  situations            Situation[]
  contratsSousTraitance ContratSousTraitant[]
  mouvementsStock       MouvementStock[]
  pointages             Pointage[]
  mouvementsTresorerie  MouvementTresorerie[]

  @@index([nom])
  @@index([statut])
  @@schema("tce_maroc")
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINEE
  BLOQUEE

  @@schema("tce_maroc")
}

// Planning simplifié type Gantt : une tâche peut avoir un prédécesseur
// (chaîne de dépendance linéaire). Pas de graphe de dépendances complexe
// pour cette première version — suffisant pour visualiser un enchaînement
// de phases de chantier.
model TacheChantier {
  id             String          @id @default(uuid())
  chantierId     String
  chantier       Chantier        @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  nom            String
  dateDebut      DateTime?
  dateFin        DateTime?
  avancement     Int             @default(0)
  statut         StatutTache     @default(A_FAIRE)
  ordre          Int             @default(0)
  predecesseurId String?
  predecesseur   TacheChantier?  @relation("TachePredecesseur", fields: [predecesseurId], references: [id], onDelete: SetNull)
  successeurs    TacheChantier[] @relation("TachePredecesseur")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([chantierId])
  @@schema("tce_maroc")
}

enum CategorieDepense {
  MAIN_DOEUVRE
  MATERIAUX
  SOUS_TRAITANCE
  LOCATION_MATERIEL
  AUTRE

  @@schema("tce_maroc")
}

// Dépense réelle rattachée à un chantier — base du suivi budgétaire
// (prévu vs réel). Les modules Achats et RH (à venir) créeront ces lignes
// automatiquement dans certains cas ; la saisie manuelle reste possible
// pour ce qui ne transite pas encore par ces modules.
model DepenseChantier {
  id             String           @id @default(uuid())
  chantierId     String
  chantier       Chantier         @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  categorie      CategorieDepense
  montant        Decimal          @db.Decimal(14, 2)
  date           DateTime
  description    String?
  fournisseurId  String?
  fournisseur    Fournisseur?     @relation(fields: [fournisseurId], references: [id], onDelete: SetNull)
  sousTraitantId String?
  sousTraitant   SousTraitant?    @relation(fields: [sousTraitantId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([chantierId])
  @@schema("tce_maroc")
}

// ===== BPU (BIBLIOTHÈQUE D'OUVRAGES) =====

// Catalogue de prix unitaires réutilisables par corps d'état, pour
// accélérer la saisie des lignes de devis.
model Ouvrage {
  id                 String   @id @default(uuid())
  corpsDetat         String
  designation        String
  unite              String // m², ml, u, forfait, kg...
  prixUnitaireDefaut Decimal  @db.Decimal(12, 2)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([corpsDetat])
  @@index([designation])
  @@schema("tce_maroc")
}

// ===== DEVIS =====

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  CONVERTI

  @@schema("tce_maroc")
}

// Les montants HT/TVA/TTC ne sont jamais stockés : toujours recalculés à
// partir des lignes (même principe que le budget chantier), pour ne jamais
// se désynchroniser d'une modification de ligne.
model Devis {
  id           String      @id @default(uuid())
  numero       String      @unique
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  chantierId   String?
  chantier     Chantier?   @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date         DateTime    @default(now())
  dateValidite DateTime?
  statut       StatutDevis @default(BROUILLON)
  tauxTva      Decimal     @default(20) @db.Decimal(5, 2)
  conditions   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lots      LotDevis[]
  lignes    LigneDevis[]
  commandes Commande[]
  factures  Facture[]

  @@index([clientId])
  @@index([statut])
  @@schema("tce_maroc")
}

// Regroupement des lignes par corps d'état/poste au sein d'un devis
// ("devis détaillés par lots/postes").
model LotDevis {
  id      String       @id @default(uuid())
  devisId String
  devis   Devis        @relation(fields: [devisId], references: [id], onDelete: Cascade)
  nom     String
  ordre   Int          @default(0)
  lignes  LigneDevis[]

  @@schema("tce_maroc")
}

model LigneDevis {
  id           String    @id @default(uuid())
  devisId      String
  devis        Devis     @relation(fields: [devisId], references: [id], onDelete: Cascade)
  lotId        String?
  lot          LotDevis? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  designation  String
  unite        String
  quantite     Decimal   @db.Decimal(12, 3)
  prixUnitaire Decimal   @db.Decimal(12, 2)
  ordre        Int       @default(0)

  @@index([devisId])
  @@schema("tce_maroc")
}

// ===== COMMANDE =====

enum StatutCommande {
  BROUILLON
  CONFIRMEE
  ANNULEE
  FACTUREE

  @@schema("tce_maroc")
}

// Créée à partir d'un devis accepté (copie figée des lignes au moment de la
// conversion) ou directement — les deux chemins existent dans le métier.
model Commande {
  id         String         @id @default(uuid())
  numero     String         @unique
  devisId    String?
  devis      Devis?         @relation(fields: [devisId], references: [id], onDelete: SetNull)
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  chantierId String?
  chantier   Chantier?      @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date       DateTime       @default(now())
  statut     StatutCommande @default(BROUILLON)
  tauxTva    Decimal        @default(20) @db.Decimal(5, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  lignes        LigneCommande[]
  factures      Facture[]
  bonsLivraison BonLivraison[]
  situations    Situation[]

  @@index([clientId])
  @@schema("tce_maroc")
}

model LigneCommande {
  id           String   @id @default(uuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  designation  String
  unite        String
  quantite     Decimal  @db.Decimal(12, 3)
  prixUnitaire Decimal  @db.Decimal(12, 2)
  ordre        Int      @default(0)

  @@index([commandeId])
  @@schema("tce_maroc")
}

// ===== BON DE LIVRAISON =====

// Document non fiscal : constate la livraison réelle (quantités remises),
// distinct de la facture (ce qui est dû) et sans détail TVA/HT/TTC. Pas de
// statut/workflow — librement modifiable/supprimable, à la différence des
// pièces financières dont le verrouillage protège paiements/stock déjà
// engagés. Rattaché à un client (obligatoire), un chantier et une commande
// d'origine (facultatifs, pour traçabilité devis/commande → livraison).
model BonLivraison {
  id            String    @id @default(uuid())
  numero        String    @unique
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  commandeId    String?
  commande      Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  date          DateTime  @default(now())
  lieuLivraison String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lignes LigneBonLivraison[]

  @@index([clientId])
  @@index([chantierId])
  @@schema("tce_maroc")
}

model LigneBonLivraison {
  id                String       @id @default(uuid())
  bonLivraisonId    String
  bonLivraison      BonLivraison @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  designation       String
  unite             String
  quantiteCommandee Decimal?     @db.Decimal(12, 3)
  quantiteLivree    Decimal      @db.Decimal(12, 3)
  observations      String?
  ordre             Int          @default(0)

  @@index([bonLivraisonId])
  @@schema("tce_maroc")
}

// ===== FACTURE =====

enum TypeFacture {
  FACTURE
  AVOIR

  @@schema("tce_maroc")
}

enum StatutFacture {
  BROUILLON
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
  ANNULEE

  @@schema("tce_maroc")
}

// Mentions légales marocaines obligatoires (ICE/IF/RC de la société,
// numérotation continue) portées par la Societe + Numerotation existantes,
// pas dupliquées ici.
model Facture {
  id                  String        @id @default(uuid())
  numero              String        @unique
  type                TypeFacture   @default(FACTURE)
  devisId             String?
  devis               Devis?        @relation(fields: [devisId], references: [id], onDelete: SetNull)
  commandeId          String?
  commande            Commande?     @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  chantierId          String?
  chantier            Chantier?     @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date                DateTime      @default(now())
  dateEcheance        DateTime?
  statut              StatutFacture @default(BROUILLON)
  tauxTva             Decimal       @default(20) @db.Decimal(5, 2)
  tauxRetenueGarantie Decimal       @default(0) @db.Decimal(5, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lignes    LigneFacture[]
  paiements Paiement[]

  @@index([clientId])
  @@index([statut])
  @@schema("tce_maroc")
}

model LigneFacture {
  id           String  @id @default(uuid())
  factureId    String
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  designation  String
  unite        String
  quantite     Decimal @db.Decimal(12, 3)
  prixUnitaire Decimal @db.Decimal(12, 2)
  ordre        Int     @default(0)

  @@index([factureId])
  @@schema("tce_maroc")
}

model Paiement {
  id        String            @id @default(uuid())
  factureId String
  facture   Facture           @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant   Decimal           @db.Decimal(12, 2)
  date      DateTime
  mode      String? // Espèces, Chèque, Virement...
  reference String?
  compteId  String? // rattachement optionnel à un compte de trésorerie, pour que son solde reflète les encaissements clients
  compte    CompteTresorerie? @relation(fields: [compteId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([factureId])
  @@index([compteId])
  @@schema("tce_maroc")
}

// ===== ACHATS & STOCK =====

// Catalogue des matériaux/articles suivis en stock. Le niveau de stock et sa
// valorisation ne sont jamais stockés ici : toujours recalculés à partir du
// grand livre MouvementStock (même principe que le budget chantier et les
// totaux devis/facture) — pas de compteur qui pourrait dériver des
// mouvements réels.
model Article {
  id          String   @id @default(uuid())
  nom         String
  categorie   String?
  unite       String
  seuilAlerte Decimal? @db.Decimal(12, 3)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mouvements     MouvementStock[]
  lignesCommande LigneCommandeFournisseur[]

  @@index([nom])
  @@schema("tce_maroc")
}

enum StatutCommandeFournisseur {
  BROUILLON
  ENVOYEE
  PARTIELLEMENT_RECUE
  RECUE
  ANNULEE

  @@schema("tce_maroc")
}

// Achat auprès d'un fournisseur — distinct de Commande (qui représente une
// vente à un client). La réception (totale ou partielle) génère
// automatiquement des MouvementStock ENTREE pour les lignes liées à un
// article du catalogue.
model CommandeFournisseur {
  id            String                    @id @default(uuid())
  numero        String                    @unique
  fournisseurId String
  fournisseur   Fournisseur               @relation(fields: [fournisseurId], references: [id])
  chantierId    String?
  chantier      Chantier?                 @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date          DateTime                  @default(now())
  statut        StatutCommandeFournisseur @default(BROUILLON)
  tauxTva       Decimal                   @default(20) @db.Decimal(5, 2)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  lignes     LigneCommandeFournisseur[]
  mouvements MouvementStock[]

  @@index([fournisseurId])
  @@index([statut])
  @@schema("tce_maroc")
}

model LigneCommandeFournisseur {
  id                    String              @id @default(uuid())
  commandeFournisseurId String
  commandeFournisseur   CommandeFournisseur @relation(fields: [commandeFournisseurId], references: [id], onDelete: Cascade)
  articleId             String?
  article               Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)
  designation           String
  unite                 String
  quantiteCommandee     Decimal             @db.Decimal(12, 3)
  quantiteRecue         Decimal             @default(0) @db.Decimal(12, 3)
  prixUnitaire          Decimal             @db.Decimal(12, 2)
  ordre                 Int                 @default(0)

  @@index([commandeFournisseurId])
  @@schema("tce_maroc")
}

enum TypeMouvementStock {
  ENTREE
  SORTIE

  @@schema("tce_maroc")
}

// Grand livre des mouvements de stock — seule source de vérité pour le
// niveau de stock et sa valorisation (coût moyen pondéré calculé à partir
// des ENTREE). Une ENTREE référence en général une réception de commande
// fournisseur ; une SORTIE référence en général une consommation sur
// chantier.
model MouvementStock {
  id                    String               @id @default(uuid())
  articleId             String
  article               Article              @relation(fields: [articleId], references: [id])
  type                  TypeMouvementStock
  quantite              Decimal              @db.Decimal(12, 3)
  prixUnitaire          Decimal?             @db.Decimal(12, 2) // requis pour une ENTREE (sert au calcul du CMP)
  chantierId            String?
  chantier              Chantier?            @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  commandeFournisseurId String?
  commandeFournisseur   CommandeFournisseur? @relation(fields: [commandeFournisseurId], references: [id], onDelete: SetNull)
  date                  DateTime             @default(now())
  notes                 String?
  createdAt             DateTime             @default(now())

  @@index([articleId])
  @@index([chantierId])
  @@schema("tce_maroc")
}

// ===== RH & POINTAGE =====

enum TypeContrat {
  CDI
  CDD
  JOURNALIER
  AUTRE

  @@schema("tce_maroc")
}

// Fiche employé — distincte d'Utilisateur (qui représente un compte de
// connexion à l'app) : la plupart des ouvriers de chantier n'ont pas de
// compte ERP, mais ont bien une fiche RH pour le pointage et la paie.
model Employe {
  id           String      @id @default(uuid())
  nom          String
  prenom       String
  cin          String?
  cnss         String?
  poste        String?
  typeContrat  TypeContrat @default(CDI)
  dateEmbauche DateTime?
  tauxHoraire  Decimal?    @db.Decimal(10, 2)
  telephone    String?
  email        String?
  adresse      String?
  notes        String?
  actif        Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  pointages Pointage[]

  @@index([nom])
  @@schema("tce_maroc")
}

enum StatutPointage {
  PRESENT
  ABSENT
  CONGE
  MALADIE
  JOUR_FERIE

  @@schema("tce_maroc")
}

// Pointage journalier — un seul enregistrement par employé et par jour
// (contrainte unique) : reflète la réalité d'une feuille de présence
// papier/quotidienne, pas un système de badgeuse horodatée.
model Pointage {
  id           String         @id @default(uuid())
  employeId    String
  employe      Employe        @relation(fields: [employeId], references: [id], onDelete: Cascade)
  chantierId   String?
  chantier     Chantier?      @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date         DateTime
  statut       StatutPointage @default(PRESENT)
  nombreHeures Decimal?       @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([employeId, date])
  @@index([chantierId])
  @@index([date])
  @@schema("tce_maroc")
}

// ===== FINANCES & TRÉSORERIE =====

enum TypeCompteTresorerie {
  BANQUE
  CAISSE

  @@schema("tce_maroc")
}

// Compte bancaire ou caisse espèces. Le solde n'est jamais stocké : toujours
// recalculé (soldeInitial + encaissements réalisés - décaissements réalisés)
// à partir des Paiement et MouvementTresorerie qui lui sont rattachés — même
// principe que le budget chantier et le stock.
model CompteTresorerie {
  id           String               @id @default(uuid())
  nom          String
  type         TypeCompteTresorerie @default(BANQUE)
  banque       String?
  rib          String?
  soldeInitial Decimal              @default(0) @db.Decimal(14, 2)
  actif        Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  mouvements MouvementTresorerie[]
  paiements  Paiement[]

  @@index([nom])
  @@schema("tce_maroc")
}

enum SensMouvement {
  ENCAISSEMENT
  DECAISSEMENT

  @@schema("tce_maroc")
}

// PREVU = échéance saisie à l'avance (alimente l'échéancier des
// décaissements à venir), REALISE = mouvement effectif (compte dans le
// solde et peut être rapproché avec le relevé bancaire).
enum StatutMouvement {
  PREVU
  REALISE

  @@schema("tce_maroc")
}

enum ModePaiementTresorerie {
  ESPECES
  CHEQUE
  VIREMENT
  EFFET
  AUTRE

  @@schema("tce_maroc")
}

// Grand livre de trésorerie : tout encaissement/décaissement hors paiements
// clients (déjà couverts par Paiement/Facture) — règlements fournisseurs et
// sous-traitants, charges diverses, apports... Sert aussi de base à
// l'échéancier (statut PREVU) et au rapprochement bancaire (rapproche).
model MouvementTresorerie {
  id                String                 @id @default(uuid())
  compteId          String
  compte            CompteTresorerie       @relation(fields: [compteId], references: [id])
  sens              SensMouvement
  statut            StatutMouvement        @default(REALISE)
  montant           Decimal                @db.Decimal(14, 2)
  date              DateTime
  modePaiement      ModePaiementTresorerie @default(VIREMENT)
  reference         String?
  description       String?
  chantierId        String?
  chantier          Chantier?              @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  fournisseurId     String?
  fournisseur       Fournisseur?           @relation(fields: [fournisseurId], references: [id], onDelete: SetNull)
  sousTraitantId    String?
  sousTraitant      SousTraitant?          @relation(fields: [sousTraitantId], references: [id], onDelete: SetNull)
  rapproche         Boolean                @default(false)
  dateRapprochement DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([compteId])
  @@index([date])
  @@index([statut])
  @@schema("tce_maroc")
}

// Journal d'audit des actions sensibles (création/modification/suppression
// sur les entités métier, connexions...). Append-only : jamais modifié ni
// supprimé par l'application elle-même.
model JournalAudit {
  id            String       @id @default(uuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  action        String // ex. 'LOGIN', 'CREATE_CHANTIER', 'UPDATE_DEVIS'
  entite        String? // ex. 'Chantier', 'Devis'
  entiteId      String?
  metadonnees   Json?
  createdAt     DateTime     @default(now())

  @@index([utilisateurId])
  @@index([entite, entiteId])
  @@schema("tce_maroc")
}

// ===== DOCUMENTS & PIÈCES JOINTES =====

enum TypeEntiteDocument {
  CHANTIER
  CLIENT
  FOURNISSEUR
  SOUS_TRAITANT
  DEVIS
  COMMANDE
  FACTURE
  COMMANDE_FOURNISSEUR
  BON_LIVRAISON
  SITUATION
  CONTRAT_SOUS_TRAITANCE

  @@schema("tce_maroc")
}

// ===== SOUS-TRAITANCE =====

enum StatutContratSousTraitant {
  BROUILLON
  CONFIRME
  TERMINE
  ANNULE

  @@schema("tce_maroc")
}

// Marché confié à un sous-traitant (lots/lignes, prix), pendant du Bon de
// commande côté client. Sert de base aux Situations sous-traitant (avancement
// cumulé facturé au fil du chantier).
model ContratSousTraitant {
  id             String                    @id @default(uuid())
  numero         String                    @unique
  sousTraitantId String
  sousTraitant   SousTraitant              @relation(fields: [sousTraitantId], references: [id])
  chantierId     String?
  chantier       Chantier?                 @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date           DateTime                  @default(now())
  statut         StatutContratSousTraitant @default(BROUILLON)
  tauxTva        Decimal                   @default(20) @db.Decimal(5, 2)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  lignes     LigneContratSousTraitant[]
  situations Situation[]

  @@index([sousTraitantId])
  @@schema("tce_maroc")
}

model LigneContratSousTraitant {
  id                    String              @id @default(uuid())
  contratSousTraitantId String
  contratSousTraitant   ContratSousTraitant @relation(fields: [contratSousTraitantId], references: [id], onDelete: Cascade)
  designation           String
  unite                 String
  quantite              Decimal             @db.Decimal(12, 3)
  prixUnitaire          Decimal             @db.Decimal(12, 2)
  ordre                 Int                 @default(0)

  @@index([contratSousTraitantId])
  @@schema("tce_maroc")
}

// ===== SITUATIONS DE TRAVAUX =====

enum StatutSituation {
  BROUILLON
  ENVOYEE
  PAYEE
  ANNULEE

  @@schema("tce_maroc")
}

// Décompte d'avancement périodique (mensuel en général) : pour chaque ligne
// du marché, le % cumulé réalisé à date détermine le montant dû à ce stade ;
// le montant de LA situation = montant cumulé - montant déjà facturé sur les
// situations précédentes du même marché. Rattachée à une Commande (marché
// client) OU un ContratSousTraitant (marché sous-traitant), jamais les deux —
// vérifié en service, pas en contrainte SQL (Prisma ne modélise pas XOR).
// Les lignes sont une photo figée (désignation/prix/quantité du marché au
// moment de la situation) plutôt qu'une FK vers la ligne du marché, pour ne
// pas dépendre de lignes qui peuvent être remplacées si le marché est modifié.
model Situation {
  id                    String               @id @default(uuid())
  numero                String               @unique
  numeroSituation       Int // 1, 2, 3... séquentiel pour CE marché
  commandeId            String?
  commande              Commande?            @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  contratSousTraitantId String?
  contratSousTraitant   ContratSousTraitant? @relation(fields: [contratSousTraitantId], references: [id], onDelete: SetNull)
  chantierId            String?
  chantier              Chantier?            @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  date                  DateTime             @default(now())
  statut                StatutSituation      @default(BROUILLON)
  tauxTva               Decimal              @default(20) @db.Decimal(5, 2)
  tauxRetenueGarantie   Decimal              @default(0) @db.Decimal(5, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  lignes LigneSituation[]

  @@index([commandeId])
  @@index([contratSousTraitantId])
  @@schema("tce_maroc")
}

model LigneSituation {
  id                          String    @id @default(uuid())
  situationId                 String
  situation                   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  designation                 String
  unite                       String
  quantiteMarche              Decimal   @db.Decimal(12, 3)
  prixUnitaire                Decimal   @db.Decimal(12, 2)
  avancementPrecedentPourcent Decimal   @default(0) @db.Decimal(5, 2)
  avancementCumulePourcent    Decimal   @db.Decimal(5, 2)
  ordre                       Int       @default(0)

  @@index([situationId])
  @@schema("tce_maroc")
}

// Pièce jointe générique (photo de chantier, devis signé scanné, CIN...),
// rattachée par (entiteType, entiteId) plutôt que par une colonne de clé
// étrangère par entité — même principe que JournalAudit. Le contenu est
// stocké directement en base (bytea) : pas de service de stockage objet
// configuré pour cette app, acceptable au volume d'une PME du BTP ; à
// migrer vers un stockage objet si les volumes de fichiers grossissent.
model Document {
  id           String             @id @default(uuid())
  nom          String
  typeMime     String
  tailleOctets Int
  contenu      Bytes
  entiteType   TypeEntiteDocument
  entiteId     String
  uploadedById String?
  uploadedPar  Utilisateur?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([entiteType, entiteId])
  @@schema("tce_maroc")
}
