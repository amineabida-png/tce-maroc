# Base de données (fournie par le service Postgres Railway)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Secrets JWT — générer des valeurs aléatoires longues, différentes entre
# elles et jamais commitées. Ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-different-from-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Serveur
NODE_ENV=development
PORT=3000

# URL du frontend (pour CORS) — en production, si servi par le même
# service, laisser vide.
FRONTEND_URL=

# Amorçage (prisma/seed.ts) — optionnels, sinon un mot de passe admin est
# généré aléatoirement et affiché une seule fois dans les logs au premier
# démarrage.
ADMIN_EMAIL=admin@tce-maroc.local
ADMIN_PASSWORD=
